#!/bin/sh
# Enable once per clone: git config core.hooksPath .githooks
top="$(git rev-parse --show-toplevel)"
python "$top/scripts/check-no-secrets.py" || exit 1
python "$top/scripts/check-unsafe-deletes.py" || exit 1
python "$top/scripts/check-board-archive.py" || exit 1
python "$top/scripts/check-no-holdout-in-tracked-files.py" || exit 1
python "$top/scripts/check-no-personal-names.py" || exit 1
python "$top/scripts/check-decisions-index.py" || exit 1
