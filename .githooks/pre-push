#!/bin/sh
# D134: unlike optional convenience checks, process accountability blocks pushes.
top="$(git rev-parse --show-toplevel)"
if ! gh auth status >/dev/null 2>&1; then
  echo "pre-push: mob-process skipped because gh is not authenticated; push blocked. Run 'gh auth login'." >&2
  exit 1
fi
python "$top/scripts/mob_process.py" check
