// <auto-generated>
// Emitted by the Avowry C# adapter. Change the .avowry source, not this file.
// Method bodies are the avows' `native csharp` blocks, passed through unchanged.
// </auto-generated>
#nullable enable
using System.Diagnostics.CodeAnalysis;

namespace Tasks;

public interface ITaskStore
{
    void Save(Task item);
    Task? Find(string id);
    bool Remove(string id);
    IReadOnlyList<Task> List();
}

public class InMemoryTaskStore : ITaskStore
{
    private readonly List<Task> items = new();
    private readonly object gate = new();

    public void Save(Task item)
    {
        lock (gate)
        {
            for (var index = 0; index < items.Count; index++)
            {
                if (items[index].Id == item.Id)
                {
                    items[index] = item;
                    return;
                }
            }

            items.Add(item);
        }
    }

    public Task? Find(string id)
    {
        lock (gate)
        {
            foreach (var item in items)
            {
                if (item.Id == id)
                    return item;
            }

            return null;
        }
    }

    public bool Remove(string id)
    {
        lock (gate)
        {
            for (var index = 0; index < items.Count; index++)
            {
                if (items[index].Id == id)
                {
                    items.RemoveAt(index);
                    return true;
                }
            }

            return false;
        }
    }

    public IReadOnlyList<Task> List()
    {
        lock (gate)
            return items.ToArray();
    }
}

public static class Avows
{
    /// <summary>create task {id} titled {title}</summary>
    [Avow("create task {id: Id} titled {title: Text} -> Task")]
    public static Task CreateTaskIdTitledTitle(ITaskStore taskstore, string id, string title)
    {
        var task = new Task(id, title, false);
        taskstore.Save(task);
        return task;
    }

    /// <summary>validate task title {title}</summary>
    /// <remarks>Fails with: EmptyTitle, TitleTooLong</remarks>
    [Avow("validate task title {title: Text}")]
    public static void ValidateTaskTitleTitle(string title)
    {
        // ensure title is not blank else EmptyTitle
        if (string.IsNullOrWhiteSpace(title)) AvowryFailure.Raise("EmptyTitle");
        // ensure title length at most 200 else TitleTooLong
        if (title.Length > 200) AvowryFailure.Raise("TitleTooLong");
    }

    /// <summary>find task {id}</summary>
    /// <remarks>Fails with: NotFound</remarks>
    [Avow("find task {id: Id} -> Task")]
    public static Task FindTaskId(ITaskStore taskstore, string id)
    {
        var task = taskstore.Find(id);
        if (task is null)
            Fail("NotFound");
        return task;
    }

    /// <summary>list tasks {available}</summary>
    /// <remarks>Fails with: StoreUnavailable</remarks>
    [Avow("list tasks {available: Bool} -> List<Task>")]
    public static IReadOnlyList<Task> ListTasksAvailable(ITaskStore taskstore, bool available)
    {
        if (!available)
            Fail("StoreUnavailable");
        return taskstore.List();
    }

    /// <summary>save {task}</summary>
    [Avow("save {task: Task}")]
    public static void SaveTask(ITaskStore taskstore, Task task)
    {
        taskstore.Save(task);
    }

    /// <summary>delete task {id}</summary>
    /// <remarks>Fails with: NotFound</remarks>
    [Avow("delete task {id: Id}")]
    public static void DeleteTaskId(ITaskStore taskstore, string id)
    {
        if (!taskstore.Remove(id))
            Fail("NotFound");
    }

    [DoesNotReturn]
    private static void Fail(string code) => AvowryFailure.Raise(code);
}
