using FastEndpoints;

namespace Tasks;

public sealed record CompleteTaskRequest(string Id);

public sealed record CompleteTaskResponse(Task Task);

/// <summary>Pure handler: the endpoint's steps, one line per step.</summary>
[Avow("endpoint CompleteTask : PUT /tasks/{id}/complete")]
public static class CompleteTaskHandler
{    public static CompleteTaskResponse Handle(CompleteTaskRequest input, ITaskStore taskstore)
    {
        // let task = find task input.id
        var task = Avows.FindTaskId(taskstore, input.Id);
        // let completed = task with { done: true }
        var completed = task with { Done = true };
        // save completed
        Avows.SaveTask(taskstore, completed);
        // respond with { task: completed }
        return new CompleteTaskResponse(Task: completed);
    }
}

/// <summary>HTTP binding. Declared failures map to 422 with the code as the error.</summary>
public sealed class CompleteTaskEndpoint(ITaskStore taskstore) : Endpoint<CompleteTaskRequest, CompleteTaskResponse>
{
    public override void Configure()
    {
        Put("/tasks/{id}/complete");
        AllowAnonymous();
    }

    public override async global::System.Threading.Tasks.Task HandleAsync(CompleteTaskRequest req, CancellationToken ct)
    {
        try
        {
            await Send.OkAsync(CompleteTaskHandler.Handle(req, taskstore), ct);
        }
        catch (AvowryFailure failure)
        {
            AddError(failure.Code);
            await Send.ErrorsAsync(422, ct);
        }
    }
}
