using FastEndpoints;
using Tasks;

namespace Tasks.Specs;

public class CompleteTaskSpecs
{
    [Fact(DisplayName = "CompleteTask: a known task becomes complete")]
    public async global::System.Threading.Tasks.Task CompleteTask__a_known_task_becomes_complete()
    {
        // Given input new CompleteTaskRequest(Id: "task-1")
        var input = new CompleteTaskRequest(Id: "task-1");
        var taskstore = new InMemoryTaskStore();
        taskstore.Save(new Task(Id: "task-1", Title: "Write the demo", Done: true));
        // When handled
        var endpoint = Factory.Create<CompleteTaskEndpoint>(context => context.Response.Body = new MemoryStream(), taskstore);
        await endpoint.HandleAsync(input, CancellationToken.None);
        // Then responds new CompleteTaskResponse(Task: new Task(Id: "task-1", Title: "Write the demo", Done: true))
        Assert.Equal(200, endpoint.HttpContext.Response.StatusCode);
        AssertSpecEqual("a known task becomes complete", new CompleteTaskResponse(Task: new Task(Id: "task-1", Title: "Write the demo", Done: true)), endpoint.Response);
    }

    [Fact(DisplayName = "CompleteTask: an unknown task is NotFound")]
    public async global::System.Threading.Tasks.Task CompleteTask__an_unknown_task_is_notfound()
    {
        // Given input new CompleteTaskRequest(Id: "missing")
        var input = new CompleteTaskRequest(Id: "missing");
        var taskstore = new InMemoryTaskStore();
        // When handled
        var endpoint = Factory.Create<CompleteTaskEndpoint>(context => context.Response.Body = new MemoryStream(), taskstore);
        await endpoint.HandleAsync(input, CancellationToken.None);
        // Then fails with NotFound
        Assert.Equal(422, endpoint.HttpContext.Response.StatusCode);
        endpoint.HttpContext.Response.Body.Position = 0;
        var body = await new StreamReader(endpoint.HttpContext.Response.Body).ReadToEndAsync();
        Assert.Contains("NotFound", body, StringComparison.Ordinal);
    }

