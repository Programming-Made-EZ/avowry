        await endpoint.HandleAsync(input, CancellationToken.None);
        // Then fails with StoreUnavailable
        Assert.Equal(422, endpoint.HttpContext.Response.StatusCode);
        endpoint.HttpContext.Response.Body.Position = 0;
        var body = await new StreamReader(endpoint.HttpContext.Response.Body).ReadToEndAsync();
        Assert.Contains("StoreUnavailable", body, StringComparison.Ordinal);
    }

    private static void AssertSpecEqual(string spec, object expected, object actual)
    {
        try
        {
            Assert.Equivalent(expected, actual, strict: true);
        }
        catch (Xunit.Sdk.XunitException)
        {
            throw new Xunit.Sdk.XunitException($"Spec \"{spec}\" expected {Format(expected)} but got {Format(actual)}.");
        }
    }

    private static string Format(object value) => value is System.Collections.IEnumerable items and not string
        ? "[" + string.Join(", ", items.Cast<object>().Select(Format)) + "]"
        : value?.ToString() ?? "null";
}
