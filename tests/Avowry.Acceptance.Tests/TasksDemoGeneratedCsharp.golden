using System.Diagnostics.CodeAnalysis;

namespace Tasks;

/// <summary>Links a generated symbol back to the avow it came from.</summary>
[AttributeUsage(AttributeTargets.Method | AttributeTargets.Class)]
public sealed class AvowAttribute(string template) : Attribute
{
    public string Template { get; } = template;
}

/// <summary>A declared failure code raised by an avow (`fails with Code`).</summary>
public sealed class AvowryFailure(string code) : Exception(code)
{
