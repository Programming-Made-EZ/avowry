# composite-let-of-valueless-phrase: a let step cannot bind a composite phrase, which returns no value (multi-level composites are not expressible today; see card 189)
module CompositeLet

avow to "reject {n: Int}" -> Int
  fails with Rejected
  native csharp
    if (n < 0) Fail("Rejected");
    return n;

avow to "inner {n: Int}"
  steps
    let checked = reject n

avow to "outer {n: Int}"
  steps
    let again = inner n

endpoint Check : POST /check
  input
    n: Int
  steps
    outer input.n
