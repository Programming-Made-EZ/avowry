# crlf-source: shared-failure content stored with CRLF line endings
module SharedFailure

phrase "reject {n: Int}"
  fails with Rejected
  native csharp
    if (n < 0) Fail("Rejected");

endpoint First : POST /first
  input
    n: Int
  steps
    reject input.n

endpoint Second : POST /second
  input
    n: Int
  steps
    reject input.n

endpoint Third : POST /third
  input
    n: Int
  steps
    reject input.n
