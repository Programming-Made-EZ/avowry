-def parse_vote(text):
-    """(vote, reason). The vote is the first sentence-start Yes, Support-it, No or ABSOLUTELY NO. Three traps are handled:
-    narration before the answer, conditional text after a No ('No. I would vote yes if ...'), and a CLI that echoes the whole
-    prompt and transcript around its answer (codex)."""
-    text = (text or "").replace("\r", "")
-    if "\ncodex\n" in text:
-        text = text.rsplit("\ncodex\n", 1)[1].split("\ntokens used", 1)[0]
-    text = re.sub(r"[^\x00-\x7f]+", "'", text).strip()
-    text = _NARRATED_NO.sub("", text)  # "No files will be changed." is narration, not a vote
-    m = _VOTE.search(text)
-    if not m:
-        return "none", ""
-    vote = VOTES[m.group(1).lower()]
-    reason = " ".join(text[m.end():].split()).lstrip(".,:;- ")
-    return vote, scrub(reason)[:240]
