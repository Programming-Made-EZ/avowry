 import hashlib
 import json
+import re
 import os
 import sys
 from pathlib import Path
 
 
+def default_vote(prompt):
+    """A counted Yes: 'Yes' plus a CITE that decider.cite_ok accepts for the proposal inside the prompt (D171): the first
+    six words, verbatim, of the proposal's first line that has six. The facilitator launches a seat with the prompt on one
+    line (newlines turned to spaces), so then the proposal's first six words are cited."""
+    proposal = re.split(r"PROPOSAL:\s", prompt, maxsplit=1)[-1].split("Vote exactly one of:", 1)[0]
+    for line in proposal.replace("\r", "").split("\n"):
+        six = re.match(r"\s*(\S+(?:[ \t]+\S+){5})", line)
+        if six:
+            return "Yes\nCITE: " + six.group(1)
+    return "Yes"
+
+
 def main():
